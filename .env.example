# Survivor 51 Draft Guide — Config
# Copy this file to .env and fill in your values

# Yahoo Fantasy App credentials
# Register at: https://developer.yahoo.com/apps/create/
# Set Redirect URI to: http://localhost:5050/auth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:5050/auth/yahoo/callback

# League config
YAHOO_LEAGUE_ID=728916

# Flask
FLASK_SECRET=change-me-to-random-string
